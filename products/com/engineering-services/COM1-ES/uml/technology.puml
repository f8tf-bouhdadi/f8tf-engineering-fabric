  component "COM1 Application Interaction Component\nTECH-COMP-02" as Application
  component "COM1 TCP Framed Channel Component\nTECH-COMP-03" as Channel
  component "COM1 Runtime Boundary Component\nTECH-COMP-04" as Runtime

  Application --> Domain
  Runtime --> Application
  Runtime --> Channel
}

cloud "TCP Byte-Stream Transport\nTECH-MECH-01" as TCP

