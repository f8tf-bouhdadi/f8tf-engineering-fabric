@startuml COM2_Engineering_Classes

title COM2 — Engineering Viewpoint — Interaction Structure

skinparam classAttributeIconSize 0

class "Interaction Submitter" as Submitter <<Engineering Role>>

class "COM2 Admission Processor" as Processor <<Computational Object>>

class "COM2 Admission Processing Basic Engineering Object" as BEO <<Basic Engineering Object>>

interface "Interaction Admission Engineering Interface" as EngIF <<Engineering Interface>>

class "Interaction Admission Channel" as Channel <<Engineering Channel>>

class "Submission Transfer" as Transfer <<Engineering Mechanism>>

class "Submission Representation" as Representation <<Engineering Mechanism>>

class "Outcome Transfer" as Outcome <<Engineering Mechanism>>

